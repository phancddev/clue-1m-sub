---
interface Props {
  title: string;
  bodyClass?: string;
}
const { title, bodyClass = 'page' } = Astro.props;
import '../styles/global.css';
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f4f8fc" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    {bodyClass === 'page' && (
      <header class="topbar">
        <a class="brand" id="brandLink" href="/" aria-label="CLUE OJ">
          <img class="clue-logo" src="/clueoj.svg" alt="" />
          
        </a>
        <slot name="aside" />
      </header>
    )}
    <slot />
  </body>
</html>
